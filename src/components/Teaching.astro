---
import teaching from '../data/teaching.json';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
type Item = { period: string; title: Record<Lang, string>; where: Record<Lang, string>; url?: string };
---
<div class="sechead"><h2>{t.nav.teaching}</h2><span class="aside">{t.teachingAside}</span></div>
<div class="groups">
  {teaching.map((g) => (
    <div class="group">
      <h3>{g.group[lang]}</h3>
      <ul>
        {(g.items as Item[]).map((it) => (
          <li>
            <span class="period">{it.period}</span>
            <div>
              <div class="title">{it.url ? <a href={it.url}>{it.title[lang]}</a> : it.title[lang]}</div>
              <div class="where">{it.where[lang]}</div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .groups { display: flex; flex-direction: column; }
  .group { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 22px; border-top: 1px solid var(--line); padding-block: 18px; }
  .group:first-child { border-top: 2px solid var(--ink); }
  h3 { font-family: var(--mono); font-size: 13px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); padding-top: 4px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 18px; align-items: baseline; }
  .period { font-family: var(--mono); font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .title { font-family: var(--serif); font-size: 19px; line-height: 1.3; }
  .title a { color: var(--ink); text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .title a:hover { color: var(--accent); }
  .where { font-size: 14px; color: var(--muted); margin-top: 3px; }
  @media (max-width: 720px) {
    .group { grid-template-columns: 1fr; gap: 12px; }
    li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
