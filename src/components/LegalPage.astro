---
import Base from '../layouts/Base.astro';

interface Props { title: string; path: string }
const { title, path } = Astro.props;
---
<Base lang="de" title={title} altPath={path}>
  <section class="block">
    <div class="wrap legal">
      <h1>{title}</h1>
      <slot />
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 720px; display: flex; flex-direction: column; gap: 14px; }
  h1 { font-size: clamp(34px, 4.4vw, 48px); margin-bottom: 12px; }
  .legal :global(h2) { font-size: 22px; margin-top: 22px; }
  .legal :global(p), .legal :global(li) { color: var(--ink); max-width: 68ch; }
  .legal :global(ul) { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .legal :global(.todo) { background: var(--amber-soft); border-radius: 3px; padding: 0 4px; }
</style>
