---
import Base from '../layouts/Base.astro';
import AgentGraph from './AgentGraph.tsx';
import TalkList from './TalkList.astro';
import Icon from './Icon.astro';
import PublicationList from './PublicationList.tsx';
import news from '../data/news.json';
import media from '../data/media.json';
import { site } from '../data/site';
import { ui, prefix, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const base = prefix(lang);
const contact = `${base}/contact/`;
---
<Base lang={lang} altPath={lang === 'en' ? '/de/' : '/'} home>
  <section class="profile" id="about">
    <AgentGraph client:idle />
    <div class="wrap">
      <div class="side">
        {site.portrait
          ? <img class="portrait photo" src={site.portrait} alt={t.portraitAlt} width="480" height="600" />
          : <div class="portrait placeholder" aria-hidden="true">PD</div>}
        <nav class="ids" aria-label={lang === 'de' ? 'Profile' : 'Profiles'}>
          <a class="pill" href={site.links.scholar}><Icon name="scholar" />Scholar</a>
          <a class="pill" href={site.links.orcid}><Icon name="orcid" />ORCID</a>
          <a class="pill" href={site.links.github}><Icon name="github" />GitHub</a>
          <a class="pill" href={site.links.linkedin}><Icon name="linkedin" />LinkedIn</a>
          {site.cv && <a class="pill" href={site.cv}><Icon name="cv" />CV</a>}
        </nav>
      </div>
      <div>
        <h1>Pascal Debus</h1>
        <p class="role" set:html={t.role} />
        <div class="bio">
          {t.bio.map((block) =>
            typeof block === 'string'
              ? <p set:html={block} />
              : <ul>{block.list.map((item) => <li set:html={item} />)}</ul>
          )}
        </div>
        <ul class="interests" aria-label="Research interests">
          {t.interests.map((it, i) => <li class={i < t.primaryInterests ? 'tag primary' : 'tag'}>{it}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="block" id="news">
    <div class="wrap">
      <div class="sechead"><h2>{t.nav.news}</h2><span class="aside">{t.newsAside}</span></div>
      <ul class="news">
        {[...news].sort((a, b) => b.date.localeCompare(a.date)).map((n) => (
          <li>
            <time datetime={n.date}>{n.date}</time>
            <span class={`kind k-${n.kind}`}>{t.kinds[n.kind as keyof typeof t.kinds]}</span>
            <span set:html={n[lang]} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block" id="talks">
    <div class="wrap">
      <TalkList lang={lang} />
    </div>
  </section>

  <section class="block" id="publications">
    <div class="wrap">
      <PublicationList lang={lang} client:visible />
    </div>
  </section>

  <section class="block" id="media">
    <div class="wrap">
      <div class="sechead"><h2>{t.nav.media}</h2><span class="aside">{t.mediaAside}</span></div>
      <div class="media">
        {media.map((m) => (
          <a class="article" href={m.url} hreflang={m.lang.toLowerCase()}>
            <span class="outlet">{m.outlet}</span>
            <h3>{m.title}</h3>
            <span class="go">{m.domain} · {m.lang} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="work">
    <div class="wrap offer">
      <div>
        <h2>{t.work.title}</h2>
        <p class="muted">{t.work.text}</p>
        <p class="muted">{t.work.contactPre} <a href={contact}>{t.work.link}</a> {t.work.contactOr} <a href={site.links.linkedin}>LinkedIn</a>.</p>
        <p class="note">{t.work.note}</p>
      </div>
      <ul>
        {t.work.items.map(([title, desc]) => (
          <li><b>{title}</b><span>{desc}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .profile { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .profile > .wrap {
    position: relative; display: grid; grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px; padding-block: 72px 64px; align-items: start;
  }
  .side { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .portrait { aspect-ratio: 4 / 5; width: 100%; height: auto; border-radius: 4px; border: 1px solid var(--line); }
  .portrait.placeholder {
    display: grid; place-items: center; background: var(--surface);
    font-family: var(--serif); font-size: 56px; color: var(--muted);
  }
  h1 { font-size: clamp(40px, 5.2vw, 60px); line-height: 1.02; }
  .role { font-size: 17px; margin-top: 10px; color: var(--muted); }
  .role :global(b) { color: var(--ink); font-weight: 500; }
  .bio { font-family: var(--serif); font-size: 17.5px; line-height: 1.6; margin-top: 22px; display: flex; flex-direction: column; gap: 12px; }
  .bio ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 8px; }
  .bio li::marker { color: var(--accent); }
  .bio :global(strong) { font-weight: 600; }
  .interests { list-style: none; margin: 22px 0 0; padding: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .ids { display: flex; gap: 6px; flex-wrap: wrap; }
  @media (max-width: 720px) {
    .profile > .wrap { grid-template-columns: 1fr; gap: 28px; padding-block: 48px; }
    .portrait { max-width: 160px; }
  }

  .news { list-style: none; margin: 0; padding: 0; }
  .news li { display: grid; grid-template-columns: 96px 86px minmax(0, 1fr); gap: 18px; padding-block: 13px; border-bottom: 1px solid var(--line); align-items: baseline; }
  .news li:last-child { border-bottom: none; }
  .news time { font-family: var(--mono); font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .kind { font-family: var(--mono); font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase; border-radius: 3px; padding: 2px 6px; justify-self: start; }
  .k-talk { color: var(--accent); background: var(--accent-soft); }
  .k-paper { color: var(--ink); background: color-mix(in srgb, var(--ink) 7%, transparent); }
  .k-press { color: var(--amber); background: var(--amber-soft); }
  @media (max-width: 640px) {
    .news li { grid-template-columns: auto 1fr; gap: 4px 12px; }
    .news li > span:last-child { grid-column: 1 / -1; }
  }

  .media { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .article {
    background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 24px;
    display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink);
    transition: border-color .15s ease;
  }
  .article:hover { border-color: var(--accent); }
  .outlet { font-family: var(--serif); font-size: 15px; font-style: italic; color: var(--muted); }
  .article h3 { font-size: 22px; line-height: 1.25; }
  .go { font-family: var(--mono); font-size: 12px; color: var(--accent); margin-top: auto; }
  @media (max-width: 720px) { .media { grid-template-columns: 1fr; } }

  .offer { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .offer h2 { font-size: clamp(26px, 3vw, 32px); }
  .offer p { max-width: 56ch; margin-top: 12px; }
  .offer h2 + p { margin-top: 14px; }
  .offer .note { font-family: var(--mono); font-size: 11.5px; color: var(--muted); margin-top: 18px; }
  .offer ul { list-style: none; margin: 0; padding: 0; }
  .offer li { padding-block: 12px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }
  .offer li:first-child { padding-top: 0; }
  .offer li:last-child { border-bottom: none; }
  .offer li b { font-weight: 600; font-size: 15px; }
  .offer li span { font-size: 14px; color: var(--muted); }
  @media (max-width: 720px) { .offer { grid-template-columns: 1fr; gap: 24px; } }
</style>
